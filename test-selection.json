{
  "version": 2,
  "lanes": [
    {
      "name": "go",
      "patterns": [
        "**/*.go",
        "**/testdata/**",
        "**/*.fixture",
        "**/*.golden",
        "go.mod",
        "go.sum"
      ]
    },
    {
      "name": "render-template",
      "patterns": [
        ".awf/**",
        "templates/**",
        "internal/artifactregistry/**",
        "internal/catalog/**",
        "internal/manifest/**",
        "internal/outputplan/**",
        "internal/project/target.go",
        "internal/publisher/**",
        "internal/render/**"
      ]
    },
    {
      "name": "platform-sensitive",
      "patterns": [
        "**/*_darwin.go",
        "**/*_darwin_test.go",
        "**/*_linux.go",
        "**/*_linux_test.go",
        "**/*_unix.go",
        "**/*_unix_test.go",
        "**/*_windows.go",
        "**/*_windows_test.go",
        "cmd/releasecheck/**",
        "internal/effort/**",
        "internal/filepublication/**",
        "internal/filesystem/**",
        "internal/git/**",
        "internal/projectmutation/**",
        "internal/resident/**",
        "internal/snapshot/**",
        "internal/upgrade/**",
        "internal/worktree/**",
        "tools/native-release-test/**"
      ]
    },
    {
      "name": "release-archive",
      "patterns": [
        ".goreleaser.yaml",
        "LICENSE",
        "LICENSES/**",
        "README.md",
        "changelog/**",
        "cmd/releasecheck/**",
        "internal/changelog/**",
        "internal/project/VERSION",
        "internal/projectlicense/**",
        "tools/native-release-test/**"
      ]
    }
  ],
  "shared_path_patterns": [
    ".github/**",
    "Dockerfile",
    "Makefile",
    "go.mod",
    "go.sum",
    "test-selection.json",
    "x"
  ],
  "generated_go_patterns": [
    "**/*_generated.go",
    "**/*.gen.go"
  ]
}
