{
  "version": 1,
  "smoke_packages": ["./cmd/awf"],
  "shared_path_patterns": [
    ".awf/**",
    ".github/**",
    "templates/**",
    "tools/**",
    "internal/project/**",
    "*.json",
    "*.yaml",
    "*.yml",
    "**/*.json",
    "**/*.yaml",
    "**/*.yml",
    "**/*_generated.*",
    "**/*.generated.*",
    "go.mod",
    "go.sum",
    "x",
    "Makefile",
    "Dockerfile"
  ],
  "generated_go_patterns": [
    "*_generated.go",
    "*.gen.go"
  ]
}
