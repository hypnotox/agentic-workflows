    {
      "id": "fast-gate",
      "kind": "component",
      "mutation": "excluded",
      "description": "Fast commit gate measured independently from behavioral feedback."
    },
    {
      "id": "common-feedback",
      "kind": "common-local",
      "mutation": "excluded",
      "description": "Fast commit gate plus affected-package behavioral feedback."
    },
    {
      "id": "ordinary-full",
      "kind": "terminal-local",
      "mutation": "empty-universe",
      "description": "Full local gate with an exact empty selected-mutation universe."
    },
    {
      "id": "selected-mutation",
      "kind": "exceptional-local",
      "mutation": "range-selected",
      "description": "Range-selected cmd/covercheck mutation blocker."
    },
    {
      "id": "hosted-critical-path",
      "kind": "hosted",
      "mutation": "separately-timed",
      "description": "Exact-revision hosted CI critical path through every required conclusion."
    }
  ],
  "environments": [
