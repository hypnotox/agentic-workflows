{
  "descriptors": [
    {
      "key": "gateCmd",
      "kind": "string",
      "description": "Command that runs the fast pre-commit gate.",
      "default": "",
      "options": [
        "make gate",
        "go test ./..."
      ],
      "target": "var"
    },
    {
      "key": "checkCmd",
      "kind": "string",
      "description": "Command that checks rendered output for drift. Leave empty to run through the always-rendered `./awf` wrapper.",
      "default": "",
      "options": [
        "./awf check",
        "make check"
      ],
      "target": "var"
    },
    {
      "key": "testCmd",
      "kind": "string",
      "description": "Command that runs the test suite.",
      "default": "",
      "options": [
        "go test ./...",
        "npm test",
        "make test"
      ],
      "target": "var"
    }
  ]
}
