// @ts-nocheck
import { randomUUID } from "node:crypto";
import { isAbsolute, normalize } from "node:path";
import { StringEnum } from "@earendil-works/pi-ai";
import { Type } from "typebox";
import { activity, type ActivityExecutor, type ActivityFact, type ActivityReply, type CheckoutRole, type DestinationFact } from "./client.ts";

const TRANSFER = Symbol.for("awf.effort-session-transfer.v1");
const TRANSFER_TIMEOUT_MS = 20_000;
const STALE_AFTER_MS = 2 * 60 * 60 * 1000;
const SLUG = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

type MemorySnapshot = Readonly<{ phase: string; next: string; updated: string }>;
type Association = Readonly<{
  slug: string;
  owner: string;
  title: string;
  cwd: string;
  role: CheckoutRole;
  receivingCheckout: string;
  memory: MemorySnapshot | null;
  heartbeatAt: string;
}>;
type SwitchTarget = Readonly<{ detach: false; effort: string; destination: CheckoutRole; receivingCheckout?: string }>;
type DetachTarget = Readonly<{ detach: true }>;
type Pending = Readonly<{
  token: string;
  owner: string;
  sourceInstance: string;
  sourceAssociation?: Association;
  target: SwitchTarget | DetachTarget;
  destination?: DestinationFact;
}>;
type TransferReceiver = Readonly<{
  instance: string;
  commit(ctx: CommandContext, pending: Pending & { target: SwitchTarget }, signal: AbortSignal): Promise<Association>;
  deliver(ctx: CommandContext, snapshot: Association): void;
  recover(ctx: CommandContext, slug: string, owner: string): Promise<void>;
}>;
export type EffortTransferCoordinator = { pending?: Pending; receiver?: TransferReceiver };

type CommandContext = {
  cwd: string;
  changeCwd?: (
    cwd: string,
    options?: Readonly<{ withSession?: (ctx: CommandContext) => Promise<void> }>,
  ) => Promise<Readonly<{ changed: boolean; cwd?: string; sessionFile?: string }>>;
  ui?: {
    notify?(message: string, level?: "info" | "warning" | "error"): void;
    setStatus?(key: string, value: string | undefined): void;
  };
};
type EventBus = {
  emit(name: string, payload?: unknown): unknown;
  on?(name: string, handler: (payload: unknown, ctx?: CommandContext) => void): unknown;
};
type PiLike = {
  exec: ActivityExecutor;
  registerTool(tool: unknown): void;
  registerCommand(name: string, command: unknown): void;
  queueCommand(name: string, argument?: string): void;
  on?(name: string, handler: (event: unknown, ctx: CommandContext) => Promise<void> | void): void;
  events?: EventBus;
};
export type EffortExtensionDependencies = Readonly<{
  uuid?: () => string;
  now?: () => Date;
  coordinator?: EffortTransferCoordinator;
  wait?: (milliseconds: number) => Promise<void>;
  transferTimeoutMs?: number;
}>;

class TransferFailure extends Error {
  constructor(
    readonly reply: ActivityReply,
    readonly sourceInvalidated: boolean,
    readonly sourceActivityChanged: boolean,
  ) {
    super(`effort association refused: ${reply.condition}`);
    this.name = "TransferFailure";
  }
}
class TransferTimeout extends Error {
  constructor() { super("effort association transfer timed out"); this.name = "TransferTimeout"; }
}

function processCoordinator(): EffortTransferCoordinator {
  const shared = globalThis as typeof globalThis & { [TRANSFER]?: EffortTransferCoordinator };
  return shared[TRANSFER] ??= {};
}
function immutableAssociation(value: Association): Association {
  return Object.freeze({
    ...value,
    memory: value.memory === null ? null : Object.freeze({ ...value.memory }),
  });
}
function cleanAbsolute(value: unknown): value is string {
  return typeof value === "string" && value.length <= 4096 && isAbsolute(value) && normalize(value) === value;
}
function bounded(value: unknown, maximum = 500): value is string {
  return typeof value === "string" && value.trim() !== "" && Buffer.byteLength(value, "utf8") <= maximum;
}
function advisory(ctx: CommandContext, message: string): void {
  const boundedMessage = Buffer.from(message).subarray(0, 1000).toString("utf8");
  ctx.ui?.setStatus?.("awf-effort", boundedMessage);
  ctx.ui?.notify?.(boundedMessage, "warning");
}
function axes(reply: ActivityReply, cwdChanged = false, activityChanged = false): string {
  return `changedCwd=${cwdChanged || reply.outcome?.changedCwd === true} changedActivity=${activityChanged || reply.outcome?.changedActivity === true} changedMemory=${reply.outcome?.changedMemory === true}`;
}
function snapshot(reply: ActivityReply, expectedOwner: string): Association | undefined {
  if (!reply.effort || !reply.memory || !reply.activity || reply.activity.owner !== expectedOwner) return undefined;
  return immutableAssociation({
    slug: reply.effort.slug,
    owner: expectedOwner,
    title: reply.effort.title,
    cwd: reply.activity.cwd,
    role: reply.activity.role,
    receivingCheckout: reply.activity.receivingCheckout,
    memory: { phase: reply.memory.phase, next: reply.memory.next, updated: reply.memory.updated },
    heartbeatAt: reply.activity.heartbeatAt,
  });
}
function waitDefault(milliseconds: number): Promise<void> {
  return new Promise((resolve) => {
    const timer = setTimeout(resolve, milliseconds);
    timer.unref();
  });
}
function takeoverMessage(prior: ActivityFact, now: Date): string {
  const age = Math.max(0, now.getTime() - Date.parse(prior.heartbeatAt));
  const state = age >= STALE_AFTER_MS ? "stale" : "fresh";
  return `Took over ${state} effort claim from ${prior.owner}: role=${prior.role} cwd=${prior.cwd} attached=${prior.attachedAt} heartbeat=${prior.heartbeatAt} ageMs=${age}. Presence is advisory, not a lock.`;
}

export function registerEffort(pi: PiLike, dependencies: EffortExtensionDependencies = {}): void {
  const uuid = dependencies.uuid ?? randomUUID;
  const now = dependencies.now ?? (() => new Date());
  const shared = dependencies.coordinator ?? processCoordinator();
  const wait = dependencies.wait ?? waitDefault;
  const transferTimeoutMs = dependencies.transferTimeoutMs ?? TRANSFER_TIMEOUT_MS;
  const instance = uuid();
  const unattachedOwner = uuid();
  let current: Association | undefined;
  let nameOverrideAvailable = false;
  let chain = Promise.resolve();

  const emit = (name: string, payload?: unknown): boolean => {
    try {
      pi.events?.emit(name, payload);
      return true;
    } catch {
      return false;
    }
  };
  const publishCurrent = (ctx: CommandContext): void => {
    const attached = current!;
    const metadata = {
      effort: { slug: attached.slug, title: attached.title },
      memory: attached.memory,
      activity: { heartbeatAt: attached.heartbeatAt, cwd: attached.cwd, role: attached.role },
    };
    if (!emit("remote-pi:metadata:set", { namespace: "awf", value: metadata })) advisory(ctx, "Effort metadata publication is unavailable; the activity claim remains advisory and attached.");
    if (nameOverrideAvailable && !emit("remote-pi:name-override:set", { namespace: "awf", value: attached.slug })) advisory(ctx, "Effort peer-name publication is unavailable; the activity claim remains attached.");
  };
  const publishClear = (ctx: CommandContext): void => {
    if (!emit("remote-pi:metadata:set", { namespace: "awf", value: null })) advisory(ctx, "Effort metadata cleanup is unavailable; local association is detached.");
    if (nameOverrideAvailable && !emit("remote-pi:name-override:set", { namespace: "awf", value: null })) advisory(ctx, "Effort peer-name cleanup is unavailable; local association is detached.");
  };
  const clear = (ctx: CommandContext): void => {
    current = undefined;
    publishClear(ctx);
  };
  const enqueue = (work: () => Promise<void>): Promise<void> => {
    const run = chain.then(work, work);
    chain = run.catch(() => undefined);
    return run;
  };
  const invoke = (ctx: CommandContext, args: readonly string[], signal?: AbortSignal): Promise<ActivityReply> => activity(pi.exec, ctx.cwd, args, signal);
  const ownerDetach = async (ctx: CommandContext, association: Association): Promise<ActivityReply | undefined> => {
    try {
      return await invoke(ctx, ["detach", association.slug, "--owner", association.owner]);
    } catch {
      advisory(ctx, "Effort detach failed; the existing advisory claim may remain and can be retried.");
      return undefined;
    }
  };
  const detachCurrent = async (ctx: CommandContext): Promise<void> => {
    if (!current) {
      publishClear(ctx);
      return;
    }
    const resident = current;
    const reply = await ownerDetach(ctx, resident);
    if (!reply) return;
    if (reply.condition === "detached" || reply.condition === "missing" || reply.condition === "not-owner") {
      clear(ctx);
      return;
    }
    advisory(ctx, `Effort detach refused: ${reply.condition}; ${axes(reply)}. ${reply.outcome ? reply.outcome.nextActions.join(" ") : "Retry detach."}`);
  };

  const receiver: TransferReceiver = Object.freeze({
    instance,
    commit: async (ctx, pending, signal) => {
      const destination = pending.destination;
      if (!destination || ctx.cwd !== destination.cwd) throw new Error("replacement context does not match the resolved effort checkout");
      let sourceInvalidated = false;
      let sourceActivityChanged = false;
      if (pending.sourceAssociation && pending.sourceAssociation.slug !== pending.target.effort) {
        const detached = await invoke(ctx, ["detach", pending.sourceAssociation.slug, "--owner", pending.sourceAssociation.owner], signal);
        if (detached.condition !== "detached" && detached.condition !== "missing" && detached.condition !== "not-owner") throw new TransferFailure(detached, false, false);
        sourceInvalidated = true;
        sourceActivityChanged = detached.condition === "detached";
      }
      const committed = pending.sourceAssociation?.slug === pending.target.effort
        ? await invoke(ctx, ["checkout", pending.target.effort, "--owner", pending.owner, "--cwd", destination.cwd, "--role", destination.role], signal)
        : await invoke(ctx, ["attach", pending.target.effort, "--owner", pending.owner, "--cwd", destination.cwd, "--role", destination.role, "--receiving-checkout", destination.receivingCheckout], signal);
      const accepted = pending.sourceAssociation?.slug === pending.target.effort
        ? committed.condition === "checkout-updated"
        : committed.condition === "attached" || committed.condition === "taken-over";
      const next = accepted ? snapshot(committed, pending.owner) : undefined;
      if (!next) throw new TransferFailure(committed, sourceInvalidated, sourceActivityChanged);
      if (committed.condition === "taken-over" && committed.priorClaim) advisory(ctx, takeoverMessage(committed.priorClaim, now()));
      return next;
    },
    deliver: (ctx, next) => {
      current = immutableAssociation(next);
      publishCurrent(ctx);
      ctx.ui?.setStatus?.("awf-effort", undefined);
    },
    recover: async (ctx, slug, owner) => {
      try {
        await invoke(ctx, ["detach", slug, "--owner", owner]);
      } catch {
        advisory(ctx, "Effort transfer recovery could not confirm activity cleanup; retry explicit detach from the current checkout.");
      }
      clear(ctx);
    },
  });
  shared.receiver = receiver;

  const runTransfer = async (ctx: CommandContext, pending: Pending & { target: SwitchTarget }, resolved: ActivityReply): Promise<void> => {
    const destination = resolved.destination!;
    const prepared: Pending & { target: SwitchTarget } = Object.freeze({ ...pending, destination });
    shared.pending = prepared;
    let callbackRan = false;
    const result = await ctx.changeCwd!(destination.cwd, {
      withSession: async (fresh) => {
        callbackRan = true;
        const destinationReceiver = shared.receiver;
        if (!destinationReceiver || destinationReceiver.instance === prepared.sourceInstance) {
          advisory(fresh, "Effort checkout changed, but the destination using_effort receiver is unavailable; changedCwd=true changedActivity=false changedMemory=false.");
          return;
        }
        const controller = new AbortController();
        const work = destinationReceiver.commit(fresh, prepared, controller.signal);
        const timeout = wait(transferTimeoutMs).then(() => { throw new TransferTimeout(); });
        try {
          const next = await Promise.race([work, timeout]);
          destinationReceiver.deliver(fresh, next);
        } catch (error) {
          controller.abort();
          void work.catch(() => undefined);
          await destinationReceiver.recover(fresh, prepared.target.effort, prepared.owner);
          const reply = error instanceof TransferFailure ? error.reply : undefined;
          advisory(fresh, reply
            ? `Effort checkout changed, but association was refused: ${reply.condition}; ${axes(reply, true, error instanceof TransferFailure && error.sourceActivityChanged)}. ${reply.outcome ? reply.outcome.nextActions.join(" ") : "Retry from the current checkout."}`
            : `Effort checkout changed, but association failed: ${error instanceof Error ? error.message : String(error)}; changedCwd=true. Activity recovery was attempted.`);
        }
      },
    });
    if (!result.changed) {
      const sameReceiver = shared.receiver;
      if (!sameReceiver || sameReceiver.instance !== prepared.sourceInstance) throw new Error("current using_effort receiver changed before same-checkout commit");
      try {
        const next = await sameReceiver.commit(ctx, prepared, new AbortController().signal);
        sameReceiver.deliver(ctx, next);
      } catch (error) {
        if (!(error instanceof TransferFailure) || !error.sourceInvalidated) throw error;
        await sameReceiver.recover(ctx, prepared.target.effort, prepared.owner);
        advisory(ctx, `Effort association was refused after the prior effort detached: ${error.reply.condition}; ${axes(error.reply, false, error.sourceActivityChanged)}. ${error.reply.outcome ? error.reply.outcome.nextActions.join(" ") : "Retry from the current checkout."}`);
      }
    } else if (!callbackRan) {
      throw new Error("Pi changed CWD without running the replacement-session callback");
    }
  };

  pi.registerTool({
    name: "using_effort",
    label: "Use effort",
    description: "Explicitly associate this Pi session with one effort and switch to its validated managed or receiving checkout.",
    parameters: Type.Object({
      effort: Type.Optional(Type.String({ minLength: 1, maxLength: 255 })),
      destination: Type.Optional(StringEnum(["managed", "receiving"] as const)),
      receivingCheckout: Type.Optional(Type.String({ maxLength: 4096 })),
      detach: Type.Optional(Type.Boolean()),
    }, { additionalProperties: false }),
    execute: async (_toolCallId: string, args: { effort?: string; destination?: CheckoutRole; receivingCheckout?: string; detach?: boolean }) => {
      if (args.detach === true) {
        if (args.destination !== undefined || args.receivingCheckout !== undefined) throw new Error("detach forbids destination and receivingCheckout");
      } else {
        if (!args.effort || !SLUG.test(args.effort) || !args.destination) throw new Error("effort and destination are required; effort must be a canonical slug");
        if (args.receivingCheckout !== undefined && !cleanAbsolute(args.receivingCheckout)) throw new Error("receivingCheckout must be a clean absolute path");
      }
      const token = uuid();
      const owner = current?.owner ?? unattachedOwner;
      const target: SwitchTarget | DetachTarget = args.detach === true
        ? Object.freeze({ detach: true })
        : Object.freeze({ detach: false, effort: args.effort!, destination: args.destination!, ...(args.receivingCheckout ? { receivingCheckout: args.receivingCheckout } : {}) });
      shared.pending = Object.freeze({ token, owner, sourceInstance: instance, ...(current ? { sourceAssociation: current } : {}), target });
      pi.queueCommand("awf-using-effort-continue", token);
      return {
        content: [{ type: "text", text: args.detach === true ? "Detaching this session from its effort." : "Switching this session to the explicit effort checkout." }],
        details: { token },
        terminate: true,
      };
    },
  });

  pi.registerCommand("awf-using-effort-continue", {
    description: "Continue a queued using_effort request after the current turn settles.",
    handler: async (token: string, ctx: CommandContext) => enqueue(async () => {
      const pending = shared.pending;
      if (!pending || pending.token !== token || pending.sourceInstance !== instance) {
        advisory(ctx, "The queued using_effort request is no longer current; no state changed.");
        return;
      }
      if (typeof ctx.changeCwd !== "function") {
        delete shared.pending;
        advisory(ctx, "using_effort requires Pi command-context changeCwd; changedCwd=false changedActivity=false changedMemory=false. Upgrade Pi and reload.");
        return;
      }
      if (pending.target.detach) {
        await detachCurrent(ctx);
        delete shared.pending;
        return;
      }
      const switchPending = pending as Pending & { target: SwitchTarget };
      let resolved: ActivityReply;
      try {
        resolved = await invoke(ctx, ["resolve", switchPending.target.effort, "--destination", switchPending.target.destination, ...(switchPending.target.receivingCheckout ? ["--receiving-checkout", switchPending.target.receivingCheckout] : [])]);
      } catch (error) {
        delete shared.pending;
        advisory(ctx, `Effort destination resolution failed before CWD teardown; changedCwd=false changedActivity=false changedMemory=false. ${(error as Error).message}`);
        return;
      }
      if (resolved.condition !== "ready") {
        delete shared.pending;
        advisory(ctx, `Effort destination refused: ${resolved.condition}; ${axes(resolved)}. ${resolved.outcome!.nextActions.join(" ")}`);
        return;
      }
      try {
        await runTransfer(ctx, switchPending, resolved);
      } catch (error) {
        advisory(ctx, `Effort CWD change failed before teardown; the prior association is unchanged. ${error instanceof Error ? error.message : String(error)}`);
      } finally {
        if (shared.pending?.token === pending.token) delete shared.pending;
      }
    }),
  });

  pi.on?.("session_start", (event, ctx) => {
    const reason = (event as { reason?: string } | undefined)?.reason;
    if (reason !== "cwd" || !shared.pending) {
      current = undefined;
      publishClear(ctx);
    }
  });
  pi.on?.("turn_end", (_event, ctx) => enqueue(async () => {
    if (!current) return;
    const before = current;
    try {
      const reply = await invoke(ctx, ["heartbeat", before.slug, "--owner", before.owner]);
      const next = reply.condition === "heartbeat" ? snapshot(reply, before.owner) : undefined;
      if (next) {
        current = next;
        publishCurrent(ctx);
        ctx.ui?.setStatus?.("awf-effort", undefined);
      } else if (reply.condition === "not-owner" || reply.condition === "missing") {
        clear(ctx);
        advisory(ctx, `Effort association was lost: ${reply.condition}; ${axes(reply)}.`);
      } else {
        current = immutableAssociation({ ...before, memory: null });
        publishCurrent(ctx);
        advisory(ctx, `Effort heartbeat metadata is unavailable: ${reply.condition}; activity remains advisory.`);
      }
    } catch {
      current = immutableAssociation({ ...before, memory: null });
      publishCurrent(ctx);
      advisory(ctx, "Effort heartbeat is unavailable; the completed turn continues and activity remains advisory.");
    }
  }));
  pi.on?.("session_shutdown", (event, ctx) => {
    const shutdown = event as { reason?: string; targetCwd?: string } | undefined;
    const pending = shared.pending;
    if (shutdown?.reason === "cwd" && pending && !pending.target.detach && pending.sourceInstance === instance && pending.destination?.cwd === shutdown.targetCwd) return;
    return enqueue(() => detachCurrent(ctx));
  });

  pi.events?.on?.("remote-pi:metadata:request", (_event, ctx) => { if (current) publishCurrent(ctx ?? { cwd: current.cwd }); });
  pi.events?.on?.("remote-pi:name-override:request", (_event, ctx) => { if (current && nameOverrideAvailable) publishCurrent(ctx ?? { cwd: current.cwd }); });
  pi.events?.on?.("remote-pi:capabilities", (payload, ctx) => {
    const capabilities = payload as { metadata?: { version?: unknown }; nameOverride?: { version?: unknown; namespaces?: unknown } } | undefined;
    if (capabilities?.metadata?.version !== 1) return;
    nameOverrideAvailable = capabilities.nameOverride?.version === 1 && Array.isArray(capabilities.nameOverride.namespaces) && capabilities.nameOverride.namespaces.includes("awf");
    if (current) publishCurrent(ctx ?? { cwd: current.cwd });
    else if (nameOverrideAvailable) emit("remote-pi:name-override:set", { namespace: "awf", value: null });
  });
  pi.events?.on?.("remote-pi:name-override:assigned", (payload, ctx) => {
    const assigned = payload as { namespace?: unknown; requested?: unknown; assigned?: unknown; active?: unknown; changed?: unknown } | undefined;
    if (!current || assigned?.namespace !== "awf" || assigned.active !== true || assigned.changed !== true || !bounded(assigned.assigned)) return;
    advisory(ctx ?? { cwd: current.cwd }, `Effort peer name was collision-assigned as ${assigned.assigned}; addresses remain opaque and metadata is not authority.`);
  });
  emit("remote-pi:capabilities:request", undefined);
}

export default function effortExtension(pi: PiLike): void {
  registerEffort(pi);
}
