// @ts-nocheck
export type ActivityCondition = "attached" | "taken-over" | "heartbeat" | "detached" | "not-owner" | "missing" | "invalid-memory" | "unsafe-resident";
export type ActivityFact = Readonly<{ schemaVersion: 2; owner: string; attachedAt: string; heartbeatAt: string }>;
export type EffortFact = Readonly<{ slug: string; title: string }>;
export type MemoryFact = Readonly<{ effort: string; phase: string; next: string; updated: string }>;
export type ActionableOutcome = Readonly<{ category: "operation"; condition: string; changedActivity: boolean; nextActions: readonly string[]; cause?: string }>;
export type ActivityReply = Readonly<{ schemaVersion: 2; condition: ActivityCondition; effort?: EffortFact; memory?: MemoryFact; activity?: ActivityFact; outcome?: ActionableOutcome }>;
export type ExecResult = Readonly<{ code?: number; stdout?: string; stderr?: string }>;
export type ActivityExecutor = (command: string, argv: readonly string[], options: Readonly<{ cwd: string; signal?: AbortSignal; timeout: number }>) => Promise<ExecResult>;
const MAX=50*1024, TEXT=4096, UUID=/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/, UTC=/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,9})?Z$/;
const conditions=new Set<ActivityCondition>(["attached","taken-over","heartbeat","detached","not-owner","missing","invalid-memory","unsafe-resident"]);
export class EffortProtocolError extends Error { constructor(message:string,readonly stdout="",readonly stderr=""){super(message);this.name="EffortProtocolError"} }
function obj(v:unknown):Record<string,unknown>|undefined{return v!==null&&typeof v==="object"&&!Array.isArray(v)?v as Record<string,unknown>:undefined}
function exact(v:Record<string,unknown>,keys:string[]):boolean{return Object.keys(v).length===keys.length&&Object.keys(v).every(k=>keys.includes(k))}
function text(v:unknown,n=TEXT):v is string{return typeof v==="string"&&v.trim()!==""&&Buffer.byteLength(v,"utf8")<=n}
function utc(v:unknown):v is string{return text(v)&&UTC.test(v)&&!Number.isNaN(Date.parse(v))}
function effort(v:unknown):EffortFact|undefined{const x=obj(v);return x&&exact(x,["slug","title"])&&text(x.slug,255)&&text(x.title,500)?Object.freeze({slug:x.slug,title:x.title}):undefined}
function memory(v:unknown):MemoryFact|undefined{const x=obj(v);return x&&exact(x,["effort","phase","next","updated"])&&text(x.effort,255)&&text(x.phase,500)&&text(x.next,500)&&(x.updated==="Not yet updated."||utc(x.updated))?Object.freeze({effort:x.effort,phase:x.phase,next:x.next,updated:x.updated}):undefined}
function fact(v:unknown):ActivityFact|undefined{const x=obj(v);return x&&exact(x,["schemaVersion","owner","attachedAt","heartbeatAt"])&&x.schemaVersion===2&&typeof x.owner==="string"&&UUID.test(x.owner)&&utc(x.attachedAt)&&utc(x.heartbeatAt)?Object.freeze({schemaVersion:2,owner:x.owner,attachedAt:x.attachedAt,heartbeatAt:x.heartbeatAt}):undefined}
function outcome(v:unknown):ActionableOutcome|undefined{const x=obj(v);if(!x||!Object.keys(x).every(k=>["category","condition","changedActivity","nextActions","cause"].includes(k))||x.category!=="operation"||!text(x.condition)||typeof x.changedActivity!=="boolean"||!Array.isArray(x.nextActions)||x.nextActions.length===0||!x.nextActions.every(a=>text(a))||(x.cause!==undefined&&!text(x.cause)))return;return Object.freeze({category:"operation",condition:x.condition,changedActivity:x.changedActivity,nextActions:Object.freeze([...x.nextActions] as string[]),...(x.cause===undefined?{}:{cause:x.cause as string})})}
function decode(v:unknown):ActivityReply|undefined{const x=obj(v);if(!x||x.schemaVersion!==2||typeof x.condition!=="string"||!conditions.has(x.condition as ActivityCondition))return;const c=x.condition as ActivityCondition, success=c==="attached"||c==="taken-over"||c==="heartbeat";if(success&&!exact(x,["schemaVersion","condition","effort","memory","activity"]))return;if(c==="detached"&&!exact(x,["schemaVersion","condition"]))return;if(!success&&c!=="detached"&&!exact(x,["schemaVersion","condition","outcome"]))return;const e=x.effort===undefined?undefined:effort(x.effort),m=x.memory===undefined?undefined:memory(x.memory),a=x.activity===undefined?undefined:fact(x.activity),o=x.outcome===undefined?undefined:outcome(x.outcome);if((x.effort!==undefined&&!e)||(x.memory!==undefined&&!m)||(x.activity!==undefined&&!a)||(x.outcome!==undefined&&!o)||(e&&m&&e.slug!==m.effort))return;return Object.freeze({schemaVersion:2,condition:c,...(e?{effort:e}:{}),...(m?{memory:m}:{}),...(a?{activity:a}:{}),...(o?{outcome:o}:{})})}
export async function activity(exec:ActivityExecutor,cwd:string,operation:"attach"|"heartbeat"|"detach",slug:string,owner:string,signal?:AbortSignal):Promise<ActivityReply>{let r:ExecResult;try{r=await exec("./awf",["effort","activity",operation,slug,"--owner",owner,"--json"],{cwd,signal,timeout:15000})}catch(e){throw new EffortProtocolError("awf activity execution failed","",String(e).slice(0,MAX))}const stdout=String(r.stdout??""),stderr=String(r.stderr??"");if(Buffer.byteLength(stdout)>MAX||Buffer.byteLength(stderr)>MAX)throw new EffortProtocolError("awf activity output exceeded bounds",stdout.slice(0,MAX),stderr.slice(0,MAX));if(r.code!==undefined&&r.code!==0)throw new EffortProtocolError("awf activity failed",stdout,stderr);if(!stdout.endsWith("\n")||stdout.slice(0,-1).includes("\n")||stdout==="\n")throw new EffortProtocolError("awf activity returned no single JSON envelope",stdout,stderr);let v;try{v=JSON.parse(stdout)}catch{throw new EffortProtocolError("awf activity returned malformed JSON",stdout,stderr)}const reply=decode(v);if(!reply)throw new EffortProtocolError("awf activity returned an invalid envelope",stdout,stderr);return reply}
