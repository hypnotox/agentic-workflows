// @ts-nocheck
import { readFile } from "node:fs/promises";
import { getPackageDir, type ExtensionAPI } from "@earendil-works/pi-coding-agent";

<!-- awf:include pi-minimum-runtime -->

export function formatCount(value:number):string {
  if (value < 1000) return String(Math.round(value));
  if (value < 1000000) return `${(value / 1000).toFixed(1).replace(/\.0$/, "")}k`;
  return `${(value / 1000000).toFixed(1).replace(/\.0$/, "")}m`;
}

export function contextUsageLine(ctx:any):string {
  const usage=ctx.getContextUsage();
  const compactions=ctx.sessionManager.getBranch().filter((entry:any)=>entry.type==="compaction").length;
  const window=usage?.contextWindow;
  if (!Number.isFinite(window)||window<=0) return `[session context] unavailable; compactions=${compactions}`;
  const tokens=usage?.tokens;
  if (!Number.isFinite(tokens)) return `[session context] unknown/${formatCount(window)}; compactions=${compactions}`;
  return `[session context] ${formatCount(tokens)}/${formatCount(window)} (${Math.round(tokens/window*100)}%); compactions=${compactions}`;
}

export function registerContextUsage(pi:ExtensionAPI,deps:MinimumRuntimeDependencies):void {
  if (!guardMinimumRuntime(pi,deps,["on"])) return;
  pi.on("context",(event:any,ctx:any)=>({messages:[...event.messages,{role:"custom",customType:"awf-context-usage",content:contextUsageLine(ctx),display:false,timestamp:Date.now()}]}));
}

export default async function(pi:ExtensionAPI):Promise<void> {
  const pkg=JSON.parse(await readFile(`${getPackageDir()}/package.json`,"utf8"));
  registerContextUsage(pi,{packageVersion:pkg.version});
}
