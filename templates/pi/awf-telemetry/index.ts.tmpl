import { randomUUID } from "node:crypto";
import { constants as fsConstants } from "node:fs";
import { lstat, mkdir, open, readFile, readdir, rm, unlink } from "node:fs/promises";
import { execFile as execFileCallback } from "node:child_process";
import { promisify } from "node:util";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { Type } from "typebox";
import { type ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { protocolDescriptor, identifier, validateObservation, validateSessionHeader } from "./protocol.ts";

<!-- awf:include pi-minimum-runtime -->

const execFile = promisify(execFileCallback);
const PRIVATE_DIR_MODE = 0o700;
const PRIVATE_FILE_MODE = 0o600;
const LOCK_STALE_MS = 120_000;
const MAX_GIT_OUTPUT = 1024 * 1024;
const selectionEntry = "awf.effort.selection.v1";

export type Selection = { effortId: string; sessionId: string };
function canonical(value: any): string { if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`; if (value && typeof value === "object") return `{${Object.keys(value).sort().map((key) => JSON.stringify(key)+":"+canonical(value[key])).join(",")}}`; return JSON.stringify(value); }
function rootFromExtension(file: string): string { return resolve(dirname(file), "../../.."); }
async function git(root: string, args: string[]): Promise<string> { const result = await execFile("git", ["-C", root, ...args], { timeout: 5_000, maxBuffer: MAX_GIT_OUTPUT }); return result.stdout; }

// Resolve only the primary worktree's resident root. The invoking checkout is
// intentionally retained for binary command authority and revision context.
export async function resolveControlRoot(invoking: string): Promise<{ invokingRoot: string; primaryRoot: string }> {
  const invokingRoot = (await git(invoking, ["rev-parse", "--show-toplevel"])).trim();
  const common = (await git(invokingRoot, ["rev-parse", "--path-format=absolute", "--git-common-dir"])).trim();
  if (!invokingRoot || !common) throw new Error("unable to resolve Git control root");
  const raw = await git(invokingRoot, ["worktree", "list", "--porcelain", "-z"]); const fields = raw.split("\0").filter(Boolean);
  const roots: string[] = []; for (const field of fields) { if (field.startsWith("worktree ")) roots.push(field.slice("worktree ".length)); else if (!/^(HEAD |branch |detached$|bare$|prunable)/.test(field)) throw new Error("unknown Git worktree structural record"); }
  const primary: string[] = []; for (const candidate of roots) { try { const dot = await lstat(join(candidate, ".git")); if (dot.isDirectory()) { const gitDir = (await git(candidate, ["rev-parse", "--path-format=absolute", "--git-dir"])).trim(); if (resolve(gitDir) === resolve(common)) primary.push(candidate); } } catch {} }
  if (primary.length !== 1) throw new Error("Git repository has no unique primary worktree"); return { invokingRoot, primaryRoot: resolve(primary[0]!) };
}
function validSelection(value: any): value is Selection { return !!value && typeof value === "object" && Object.keys(value).sort().join(",") === "effortId,sessionId" && identifier(value.effortId) && identifier(value.sessionId); }
export function restoreSelection(ctx: any): Selection | undefined { const branch = ctx?.sessionManager?.getBranch?.(); if (!Array.isArray(branch)) return undefined; let result: Selection | undefined; for (const entry of branch) if (entry?.type === "custom" && entry.customType === selectionEntry) result = validSelection(entry.data) ? { ...entry.data } : undefined; return result; }
async function runAwf(root: string, args: string[]): Promise<string> { const result = await execFile("awf", args, { cwd: root, timeout: 10_000, maxBuffer: MAX_GIT_OUTPUT }); return result.stdout; }
async function safeDirectory(path: string): Promise<void> { await mkdir(path, { recursive: true, mode: PRIVATE_DIR_MODE }); const stat = await lstat(path); if (!stat.isDirectory() || stat.isSymbolicLink() || (process.getuid?.()!==undefined&&stat.uid!==process.getuid?.())) throw new Error("unsafe telemetry directory"); }
async function fsyncDirectory(path: string): Promise<void> { const handle = await open(path, fsConstants.O_RDONLY); try { await handle.sync(); } finally { await handle.close(); } }
async function acquireLock(path: string, sessionId: string): Promise<() => Promise<void>> { for (let attempt=0;attempt<2;attempt++) { try { const handle=await open(path,fsConstants.O_CREAT|fsConstants.O_EXCL|fsConstants.O_WRONLY|fsConstants.O_NOFOLLOW,PRIVATE_FILE_MODE); const payload=JSON.stringify({ pid:process.pid, sessionId, createdAt:new Date().toISOString() })+"\n"; try { await handle.writeFile(payload); await handle.sync(); } finally { await handle.close(); } return async()=>{ try { const now=await lstat(path); if (!now.isFile()||now.isSymbolicLink()||(process.getuid?.()!==undefined&&now.uid!==process.getuid?.())||await readFile(path,"utf8")!==payload) throw new Error("telemetry lock ownership changed"); await unlink(path); await fsyncDirectory(dirname(path)); } catch (error:any) { if (error?.code !== "ENOENT") throw error; } }; } catch(error:any) { if(error?.code!=="EEXIST") throw error; const before=await lstat(path); if (!before.isFile()||before.isSymbolicLink()||(process.getuid?.()!==undefined&&before.uid!==process.getuid?.())) throw new Error("live or unsafe telemetry stream lock"); const bytes=await readFile(path,"utf8"); if(Buffer.byteLength(bytes,"utf8")>4096) throw new Error("live or unsafe telemetry stream lock"); let lock:any; try { lock=JSON.parse(bytes); } catch { throw new Error("live or unsafe telemetry stream lock"); } const created=typeof lock?.createdAt==="string"?Date.parse(lock.createdAt):NaN; if(!Number.isSafeInteger(lock?.pid)||lock.pid<=0||lock.sessionId!==sessionId||!Number.isFinite(created)||Date.now()-created<=LOCK_STALE_MS) throw new Error("live or unsafe telemetry stream lock"); let dead=false; try { process.kill(lock.pid,0); } catch (probe:any) { if(probe?.code==="ESRCH") dead=true; else throw new Error("live or unsafe telemetry stream lock"); } if(!dead) throw new Error("live or unsafe telemetry stream lock"); const after=await lstat(path); if(after.dev!==before.dev||after.ino!==before.ino||after.uid!==before.uid||await readFile(path,"utf8")!==bytes) throw new Error("telemetry lock changed during stale recovery"); await unlink(path); await fsyncDirectory(dirname(path)); } } throw new Error("unable to acquire telemetry stream lock"); }
async function validateExisting(path: string, sessionId: string, candidate: any): Promise<boolean> { const stat=await lstat(path); if(!stat.isFile()||stat.isSymbolicLink()||(process.getuid?.()!==undefined&&stat.uid!==process.getuid?.()))throw new Error("unsafe telemetry stream"); const bytes=await readFile(path,"utf8"); if (!bytes.endsWith("\n")) throw new Error("telemetry stream has incomplete final line"); const lines=bytes.slice(0,-1).split("\n"); let header:any; try { header=JSON.parse(lines[0]!); } catch { throw new Error("telemetry stream has malformed header"); } if (!validateSessionHeader(header)||header.sessionId!==sessionId) throw new Error("telemetry stream has invalid header"); for(const line of lines.slice(1)){let record:any;try{record=JSON.parse(line)}catch{throw new Error("telemetry stream has malformed observation")};if(!validateObservation(record))throw new Error("telemetry stream has invalid observation");if(record.observationId===candidate.observationId){if(canonical(record)!==canonical(candidate))throw new Error("observation ID conflicts with prior bytes");return true;}} return false; }

// appendSessionObservation is intentionally direct: it never invokes awf and
// never writes effort identity. A caller owns the observation UUID across retry.
export async function appendSessionObservation(extensionFile: string, sessionId: string, observation: any): Promise<{ idempotent: boolean }> { if (!identifier(sessionId) || !validateObservation(observation)) throw new Error("invalid session telemetry observation"); const roots=await resolveControlRoot(rootFromExtension(extensionFile));const sessions=join(roots.primaryRoot,".awf","metrics","sessions");await safeDirectory(join(roots.primaryRoot,".awf","metrics"));await safeDirectory(sessions);const stream=join(sessions,sessionId+".jsonl"), lock=stream+".lock";const release=await acquireLock(lock,sessionId);try{try { if(await validateExisting(stream,sessionId,observation)) return {idempotent:true}; const handle=await open(stream,fsConstants.O_WRONLY|fsConstants.O_APPEND|fsConstants.O_NOFOLLOW);try{await handle.writeFile(canonical(observation)+"\n");await handle.sync()}finally{await handle.close()};return {idempotent:false}; } catch(error:any) { if(error?.code!=="ENOENT") throw error; const header={record:"header",schemaVersion:protocolDescriptor.schemaVersion,sessionId,createdAt:new Date().toISOString()};const temp=stream+".tmp-"+randomUUID();const handle=await open(temp,fsConstants.O_CREAT|fsConstants.O_EXCL|fsConstants.O_WRONLY,PRIVATE_FILE_MODE);try{await handle.writeFile(canonical(header)+"\n"+canonical(observation)+"\n");await handle.sync()}finally{await handle.close()};try{await execFile("ln",[temp,stream]);}catch(error:any){await unlink(temp).catch(()=>undefined);await fsyncDirectory(sessions);if(error?.code===17||error?.code==="EEXIST"){if(await validateExisting(stream,sessionId,observation))return {idempotent:true};throw new Error("observation ID conflicts with raced stream publication");}throw new Error("hard-link stream publication is unavailable")};await fsyncDirectory(sessions);await unlink(temp);await fsyncDirectory(sessions);return {idempotent:false};}}finally{await release();}}
function streamObservation(kind: string,payload: any): any{return {record:"observation",schemaVersion:protocolDescriptor.schemaVersion,observationId:randomUUID(),timestamp:new Date().toISOString(),kind,payload};}

export function registerTelemetry(pi: ExtensionAPI, extensionFile = fileURLToPath(import.meta.url)): void { if (!guardMinimumRuntime(pi, { packageVersion: "{{ .version }}" }, ["registerCommand", "registerTool"])) return; let selected: Selection|undefined; const select=async(ctx:any,id:string)=>{const sessionId=ctx.sessionManager.getSessionId?.();if(!identifier(sessionId))throw new Error("session identity is unavailable");await runAwf(rootFromExtension(extensionFile),["effort","assign",id,"--session",sessionId]);selected={effortId:id,sessionId};ctx.sessionManager.appendCustomEntry(selectionEntry,selected);};pi.events.on?.("awf.effort.selection.request.v1",(request:any)=>request?.respond?.(selected));pi.registerCommand("awf-effort",{description:"Manage optional awf effort selection: new, use, clear, show, rename.",async handler(args:string,ctx:any){const [verb,...rest]=args.trim().split(/\s+/);const root=rootFromExtension(extensionFile);if(verb==="new"){const title=rest.join(" ").trim();if(!title)throw new Error("usage: /awf-effort new <title>");const result=JSON.parse(await runAwf(root,["effort","new",title,"--json"]));await select(ctx,result.id);return;}if(verb==="use"){if(rest.length!==1)throw new Error("usage: /awf-effort use <id>");await runAwf(root,["effort","show",rest[0]!,"--json"]);await select(ctx,rest[0]!);return;}if(verb==="clear"){const sessionId=ctx.sessionManager.getSessionId?.();if(!identifier(sessionId))throw new Error("session identity is unavailable");await runAwf(root,["effort","unassign","--session",sessionId]);selected=undefined;return;}if(verb==="show"){if(!selected){ctx.ui.notify("No effort selected.");return;}ctx.ui.notify((await runAwf(root,["effort","show",selected.effortId])).trim());return;}if(verb==="rename"){const title=rest.join(" ").trim();if(!selected||!title)throw new Error("usage: /awf-effort rename <title>");await runAwf(root,["effort","rename",selected.effortId,title]);return;}throw new Error("usage: /awf-effort <new|use|clear|show|rename>");}});pi.registerTool({name:"awf_workflow",label:"awf workflow",description:"Load one enabled fixed workflow body without lifecycle mutation.",parameters:Type.Object({skill:Type.String()},{additionalProperties:false}),async execute(_id:any,params:any,_signal:any,_update:any,ctx:any){if(!identifier(params?.skill))throw new Error("invalid workflow skill");const body=await readFile(join(rootFromExtension(extensionFile),".pi","awf-workflows",params.skill+".md"),"utf8");const context=selected?`\n\nOptional selected effort: ${selected.effortId}`:"";return {content:[{type:"text",text:body+context}],details:{skill:params.skill}};}});pi.on("session_start",(_event:any,ctx:any)=>{selected=restoreSelection(ctx);});pi.on("message_update",(event:any,ctx:any)=>{const usage=event?.message?.usage;if(!usage)return;const payload={inputTokens:Math.max(0,usage.input??0),outputTokens:Math.max(0,usage.output??0),cacheReadTokens:Math.max(0,usage.cacheRead??0),cacheWriteTokens:Math.max(0,usage.cacheWrite??0),costUsd:Math.max(0,usage.cost?.total??0)};const sessionId=ctx.sessionManager.getSessionId?.();if(identifier(sessionId))void appendSessionObservation(extensionFile,sessionId,streamObservation("usage",payload)).catch(()=>undefined);});}
export default async function(pi:ExtensionAPI):Promise<void>{registerTelemetry(pi);}

