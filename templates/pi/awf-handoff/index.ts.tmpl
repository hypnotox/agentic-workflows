// @ts-nocheck
import { randomUUID } from "node:crypto";
import { execFile as execFileCallback } from "node:child_process";
import { promisify } from "node:util";
import { lstat, readFile } from "node:fs/promises";
import * as nodePath from "node:path";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { getPackageDir, type ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { truncateToWidth } from "@earendil-works/pi-tui";
import { Type } from "typebox";

<!-- awf:include pi-minimum-runtime -->

const execFile=promisify(execFileCallback);
export interface HandoffStat { isSymbolicLink():boolean; isFile():boolean; isDirectory():boolean; }
export interface HandoffDependencies extends MinimumRuntimeDependencies { extensionFile:string; lstat(path:string):Promise<HandoffStat>; readFile(path:string,encoding:"utf8"):Promise<string>; path:any; randomUUID():string; setInterval(callback:()=>void,milliseconds:number):unknown; clearInterval(handle:unknown):void; setTimeout(callback:()=>void,milliseconds:number):unknown; clearTimeout(handle:unknown):void; }
function root(deps:HandoffDependencies):string{return deps.path.resolve(deps.path.dirname(deps.extensionFile),"../../..");}
function validID(value:any):boolean{return typeof value==="string"&&value.length>0&&Buffer.byteLength(value,"utf8")<=160&&!/[\\/\x00\r\n]/.test(value)&&value!=="."&&value!=="..";}
export async function validateMemoryPath(path:string,deps:HandoffDependencies):Promise<string>{if(!path||deps.path.isAbsolute(path)||!path.startsWith(".awf/memory/")||path.includes("\\")||path.split("/").some((x:string)=>!x||x==="."||x===".."))throw new Error("memoryPath must be a canonical file below .awf/memory/");let current=root(deps);for(const part of path.split("/")){current=deps.path.resolve(current,part);const stat=await deps.lstat(current);if(stat.isSymbolicLink()||(!stat.isDirectory()&&!stat.isFile()))throw new Error("memoryPath contains an unsafe filesystem entry");}return path;}
export async function validateMemoryEffort(path:string,deps:HandoffDependencies):Promise<string>{await validateMemoryPath(path,deps);const content=await deps.readFile(deps.path.resolve(root(deps),path),"utf8");const lines=content.split(/\r?\n/).filter((x:string)=>x.startsWith("Effort: "));if(lines.length!==1||!validID(lines[0]!.slice(8)))throw new Error("memory file must contain exactly one valid Effort: <id> line");return lines[0]!.slice(8);}
export function requestSelectedEffort(pi:ExtensionAPI):string|undefined{let answer:any;try{pi.events.emit("awf.effort.selection.request.v1",{respond:(value:any)=>{if(answer!==undefined)answer=null;else answer=value;}})}catch{return undefined};return answer&&validID(answer.effortId)?answer.effortId:undefined;}
export function buildKickoffWrapper(memoryPath:string|undefined,kickoff:string):string{const checkpoint=memoryPath?`Read ${memoryPath} first. Repository sources and current-state documentation are authoritative over the checkpoint. `:"";return `${checkpoint}The optional effort selection, if any, was assigned before this kickoff. Then continue with this immediate action: ${kickoff}`;}
async function runAwf(repository:string,args:string[]):Promise<void>{await execFile("awf",args,{cwd:repository,timeout:10_000,maxBuffer:1024*1024});}
/* c8 ignore next */
function countdown(ctx:any,deps:HandoffDependencies):Promise<boolean>{return ctx.ui.custom((tui:any,_theme:any,keybindings:any,done:any)=>{let seconds=5,interval:any,timeout:any,finished=false,cached:any;const finish=(result:boolean)=>{if(finished)return;finished=true;if(interval!==undefined)deps.clearInterval(interval);if(timeout!==undefined)deps.clearTimeout(timeout);done(result);};const component={render(width:number){const bounded=Math.max(1,width);if(!cached||cached.width!==bounded)cached={width:bounded,lines:[truncateToWidth(`Handoff to a fresh session in ${seconds}s - Esc/Ctrl+C to cancel`,bounded)]};return cached.lines;},invalidate(){cached=undefined;tui.requestRender();},handleInput(data:string){try{if(keybindings.matches(data,"tui.select.cancel"))finish(false);}catch(error){finish(false);throw error;}},dispose(){if(interval!==undefined)deps.clearInterval(interval);if(timeout!==undefined)deps.clearTimeout(timeout);}};try{interval=deps.setInterval(()=>{seconds=Math.max(1,seconds-1);component.invalidate();},1000);timeout=deps.setTimeout(()=>finish(true),5000);}catch(error){finish(false);throw error;}return component;});}
/* c8 ignore next */
export function registerHandoff(pi:ExtensionAPI,deps:HandoffDependencies):void{if(!guardMinimumRuntime(pi,deps,["on","eventsEmit","registerTool","registerCommand","queueCommand"]))return;let pending:any;pi.on("tool_call",(event:any,ctx:any)=>{const leaf=ctx.sessionManager.getLeafEntry?.();const content=leaf?.type==="message"&&leaf.message?.role==="assistant"&&Array.isArray(leaf.message.content)?leaf.message.content:[];const calls=content.filter((item:any)=>item?.type==="toolCall");const correlated=calls.some((call:any)=>call.id===event.toolCallId&&call.name===event.toolName);if(!correlated)return event.toolName==="handoff_session"?{block:true,reason:"Cannot verify the current tool batch; retry handoff_session alone."}:undefined;if(calls.length>1&&calls.some((call:any)=>call.name==="handoff_session"))return {block:true,reason:"A batch containing handoff_session cannot contain siblings; retry handoff_session alone."};});pi.registerCommand("awf-handoff-continue",{description:"Continue a validated fresh-session handoff.",async handler(token:string,ctx:any){const request=pending;if(!request||token!==request.id)throw new Error("No matching pending handoff request");const kickoff=buildKickoffWrapper(request.memoryPath,request.kickoff);let prepared:any;try{if(!await countdown(ctx,deps)){ctx.ui.notify("Fresh-session handoff canceled.");return;}const old=ctx.sessionManager.getSessionFile();if(!old)throw new Error("The active session is no longer persisted");await ctx.newSession({parentSession:old,async setup(manager:any){const child=manager.getSessionId?.();if(!validID(child))throw new Error("child session identity is unavailable");prepared=manager;if(request.effortId)await runAwf(root(deps),["effort","assign",request.effortId,"--session",child]);if(request.effortId)manager.appendCustomEntry?.("awf.effort.selection.v1",{effortId:request.effortId,sessionId:child});},async withSession(next:any){prepared=undefined;try{await next.sendUserMessage(kickoff);}catch{next.ui.setEditorText(kickoff);next.ui.notify("Automatic kickoff failed; submit the prepared editor text.","warning");}}});}catch(error){try{await prepared?.cleanup?.();ctx.ui.setEditorText(kickoff);ctx.ui.notify("Fresh-session handoff failed; recovery text is in the editor.","error");}catch{}throw error;}finally{if(pending?.id===request.id)pending=undefined;}}});pi.registerTool({name:"handoff_session",label:"Fresh Session Handoff",description:"Continue from an optional durable awf checkpoint in a parent-linked fresh Pi TUI session.",parameters:Type.Object({memoryPath:Type.Optional(Type.String()),kickoff:Type.String({maxLength:1000})},{additionalProperties:false}),async execute(_id:any,params:any,_signal:any,_update:any,ctx:any){if(ctx.mode!=="tui"||!ctx.sessionManager.getSessionFile?.())throw new Error("handoff_session requires a persisted interactive Pi TUI session");if(!params.kickoff?.trim())throw new Error("kickoff must contain non-whitespace content");if(pending)throw new Error("A handoff request is already pending");const selected=requestSelectedEffort(pi);let memoryEffort:any;if(params.memoryPath)memoryEffort=await validateMemoryEffort(params.memoryPath,deps);if(selected&&memoryEffort&&selected!==memoryEffort)throw new Error("memory Effort does not match selected effort");const request={id:deps.randomUUID(),memoryPath:params.memoryPath,kickoff:params.kickoff,effortId:selected};pending=request;try{pi.queueCommand("awf-handoff-continue",request.id);}catch(error){if(pending===request)pending=undefined;throw error;}return {content:[{type:"text",text:"Fresh-session handoff queued."}],details:{memoryPath:request.memoryPath},terminate:true};}});}
export default async function(pi:ExtensionAPI):Promise<void>{const pkg=JSON.parse(await readFile(join(getPackageDir(),"package.json"),"utf8"));registerHandoff(pi,{extensionFile:fileURLToPath(import.meta.url),packageVersion:pkg.version,lstat,readFile,path:nodePath,randomUUID,setInterval,clearInterval,setTimeout,clearTimeout});}
