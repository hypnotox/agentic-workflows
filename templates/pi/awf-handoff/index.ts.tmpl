export interface HandoffStat { isSymbolicLink():boolean; isFile():boolean; isDirectory():boolean; uid?:number; dev?:number|bigint; ino?:number|bigint; nlink?:number; size?:number; mtimeMs?:number; }
export interface HandoffDependencies extends MinimumRuntimeDependencies { extensionFile:string; lstat(path:string):Promise<HandoffStat>; readFile(path:string):Promise<Uint8Array>; readFile(path:string,encoding:"utf8"):Promise<string>; getuid?:()=>number; path:any; randomUUID():string; setInterval(callback:()=>void,milliseconds:number):unknown; clearInterval(handle:unknown):void; setTimeout(callback:()=>void,milliseconds:number):unknown; clearTimeout(handle:unknown):void; }
async function root(deps:HandoffDependencies):Promise<string>{const rendered=deps.path.resolve(deps.path.dirname(deps.extensionFile),"../../.."),marker=deps.path.resolve(rendered,".git"),stat=await deps.lstat(marker).catch(()=>undefined);if(!stat||stat.isSymbolicLink()||!stat.isFile()||!owned(stat,deps))return rendered;const unreadable="handoff root has an unreadable worktree .git file",gitdirLine=/^gitdir: (.+)$/.exec((await deps.readFile(marker,"utf8")).split(/\r?\n/)[0]);if(!gitdirLine)throw new Error(unreadable);const gitdir=deps.path.resolve(rendered,gitdirLine[1]);if(gitdir.split(deps.path.sep).slice(-3,-1).join("/")!==".git/worktrees")return rendered;return deps.path.resolve(gitdir,"..","..","..");}
function sameIdentity(a:HandoffStat,b:HandoffStat):boolean{return a.dev===b.dev&&a.ino===b.ino&&a.size===b.size&&a.mtimeMs===b.mtimeMs;}
function owned(stat:HandoffStat,deps:HandoffDependencies):boolean{return !deps.getuid||stat.uid===undefined||stat.uid===deps.getuid();}
function canonicalEffortScalar(value:string,slug:string):boolean{if(value===slug){if(new Set(["true","false","null","~"]).has(value))return false;if(/^[0-9]+$/.test(value))return false;if(/^0[xob][0-9a-f]+$/.test(value))return false;return true;}return [`"${slug}"`,`'${slug}'`].includes(value);}
export function hasMatchingMemoryIdentity(text:string,slug:string):boolean{if(text.startsWith(`Effort: ${slug}\n`))return true;const opening=text.startsWith("---\n")?4:text.startsWith("---\r\n")?5:0;if(!opening)return false;let cursor=opening,effort:string|undefined;for(;;){const end=text.indexOf("\n",cursor),raw=text.slice(cursor,end<0?text.length:end),line=end>=0&&raw.endsWith("\r")?raw.slice(0,-1):raw;if(line==="---")return effort===slug;if(line.startsWith("effort:")){if(effort!==undefined)return false;const value=line.slice("effort:".length).trimStart();if(!canonicalEffortScalar(value,slug))return false;effort=slug;}if(end<0)return false;cursor=end+1;}}
export async function validateMemoryPath(path:string,deps:HandoffDependencies):Promise<string>{const repositoryRoot=await root(deps),prefix=".awf/efforts/",suffix="/memory.md",slugRE=/^[a-z0-9]+(?:-[a-z0-9]+)*$/;let canonical:string;if(deps.path.isAbsolute(path)){const resolved=deps.path.resolve(path),relative=deps.path.relative(repositoryRoot,resolved);if(!relative||deps.path.isAbsolute(relative)||relative===".."||relative.startsWith(`..${deps.path.sep}`))throw new Error("memoryPath must resolve inside this repository");canonical=relative.split(deps.path.sep).join("/");if(canonical.includes("\\"))throw new Error("memoryPath cannot normalize to repository-relative slash form");}else{if(!path||path.includes("\\")||path.split("/").some((x:string)=>!x||x==="."||x===".."))throw new Error("memoryPath must be a canonical repository-relative path");canonical=path;}if(!canonical.startsWith(prefix)||!canonical.endsWith(suffix))throw new Error("memoryPath must be exactly .awf/efforts/<slug>/memory.md");const slug=canonical.slice(prefix.length,-suffix.length);if(slug.length<1||slug.length>63||!slugRE.test(slug))throw new Error("memoryPath contains an invalid effort slug");const git=await deps.lstat(deps.path.resolve(repositoryRoot,".git"));if(git.isSymbolicLink()||(!git.isFile()&&!git.isDirectory())||!owned(git,deps))throw new Error("memoryPath repository identity is unsafe");let current=repositoryRoot,leaf:HandoffStat|undefined;for(const [i,part] of canonical.split("/").entries()){current=deps.path.resolve(current,part);const stat=await deps.lstat(current),last=i===3;if(stat.isSymbolicLink()||(last?!stat.isFile():!stat.isDirectory())||!owned(stat,deps))throw new Error("memoryPath contains an unsafe filesystem entry");if(last&&(stat.nlink!==undefined&&stat.nlink!==1||stat.size!==undefined&&(stat.size<0||stat.size>1048576)))throw new Error("memoryPath must be a bounded singly-linked regular file");leaf=stat;}const raw=await deps.readFile(current);if(raw.byteLength>1048576)throw new Error("memoryPath exceeds the 1 MiB bound");let text:string;try{text=new TextDecoder("utf-8",{fatal:true}).decode(raw);}catch{throw new Error("memoryPath must contain valid UTF-8");}if(!hasMatchingMemoryIdentity(text,slug))throw new Error("memoryPath is not owned by its effort slug");const after=await deps.lstat(current);if(after.isSymbolicLink()||!after.isFile()||!owned(after,deps)||!sameIdentity(leaf!,after))throw new Error("memoryPath identity changed during validation");return canonical;}
export function buildKickoffWrapper(memoryPath:string|undefined,kickoff:string):string{const checkpoint=memoryPath?`Read ${memoryPath} first. Repository sources and current-state documentation are authoritative over the checkpoint. `:"";return `${checkpoint}Then continue with this immediate action: ${kickoff}`;}
/* c8 ignore next */
function countdown(ctx:any,deps:HandoffDependencies):Promise<boolean>{return ctx.ui.custom((tui:any,_theme:any,keybindings:any,done:any)=>{let seconds=5,interval:any,timeout:any,finished=false,cached:any;const finish=(result:boolean)=>{if(finished)return;finished=true;if(interval!==undefined)deps.clearInterval(interval);if(timeout!==undefined)deps.clearTimeout(timeout);done(result);};const component={render(width:number){const bounded=Math.max(1,width);if(!cached||cached.width!==bounded)cached={width:bounded,lines:[truncateToWidth(`Handoff to a fresh session in ${seconds}s - Esc/Ctrl+C to cancel`,bounded)]};return cached.lines;},invalidate(){cached=undefined;tui.requestRender();},handleInput(data:string){try{if(keybindings.matches(data,"tui.select.cancel"))finish(false);}catch(error){finish(false);throw error;}},dispose(){if(interval!==undefined)deps.clearInterval(interval);if(timeout!==undefined)deps.clearTimeout(timeout);}};try{interval=deps.setInterval(()=>{seconds=Math.max(1,seconds-1);component.invalidate();},1000);timeout=deps.setTimeout(()=>finish(true),5000);}catch(error){finish(false);throw error;}return component;});}
export function registerHandoff(pi:ExtensionAPI,deps:HandoffDependencies):void{if(!guardMinimumRuntime(pi,deps,["on","eventsEmit","registerTool","registerCommand","queueCommand"]))return;let pending:any;pi.on("tool_call",(event:any,ctx:any)=>{const leaf=ctx.sessionManager.getLeafEntry?.();const content=leaf?.type==="message"&&leaf.message?.role==="assistant"&&Array.isArray(leaf.message.content)?leaf.message.content:[];const calls=content.filter((item:any)=>item?.type==="toolCall");const correlated=calls.some((call:any)=>call.id===event.toolCallId&&call.name===event.toolName);if(!correlated)return event.toolName==="handoff_session"?{block:true,reason:"Cannot verify the current tool batch; retry handoff_session alone."}:undefined;if(calls.length>1&&calls.some((call:any)=>call.name==="handoff_session"))return {block:true,reason:"A batch containing handoff_session cannot contain siblings; retry handoff_session alone."};});pi.registerCommand("awf-handoff-continue",{description:"Continue a validated fresh-session handoff.",async handler(token:string,ctx:any){const request=pending;if(!request||token!==request.id)throw new Error("No matching pending handoff request");const kickoff=buildKickoffWrapper(request.memoryPath,request.kickoff);let prepared:any;try{if(!await countdown(ctx,deps)){ctx.ui.notify("Fresh-session handoff canceled.");return;}if(request.memoryPath)await validateMemoryPath(request.memoryPath,deps);const old=ctx.sessionManager.getSessionFile();if(!old)throw new Error("The active session is no longer persisted");await ctx.newSession({parentSession:old,async setup(manager:any){prepared=manager;},async withSession(next:any){prepared=undefined;try{await next.sendUserMessage(kickoff);}catch{next.ui.setEditorText(kickoff);next.ui.notify("Automatic kickoff failed; submit the prepared editor text.","warning");}}});}catch(error){try{await prepared?.cleanup?.();ctx.ui.setEditorText(kickoff);ctx.ui.notify("Fresh-session handoff failed; recovery text is in the editor.","error");}catch{}throw error;}finally{if(pending?.id===request.id)pending=undefined;}}});pi.registerTool({name:"handoff_session",label:"Fresh Session Handoff",description:"Continue from an optional effort-owned awf checkpoint in a parent-linked fresh Pi TUI session.",parameters:Type.Object({memoryPath:Type.Optional(Type.String()),kickoff:Type.String({maxLength:1000})},{additionalProperties:false}),async execute(_id:any,params:any,_signal:any,_update:any,ctx:any){if(ctx.mode!=="tui"||!ctx.sessionManager.getSessionFile?.())throw new Error("handoff_session requires a persisted interactive Pi TUI session");if(!params.kickoff?.trim())throw new Error("kickoff must contain non-whitespace content");if(pending)throw new Error("A handoff request is already pending");const memoryPath=Object.prototype.hasOwnProperty.call(params,"memoryPath")?await validateMemoryPath(params.memoryPath,deps):undefined;const request={id:deps.randomUUID(),memoryPath,kickoff:params.kickoff};pending=request;try{pi.queueCommand("awf-handoff-continue",request.id);}catch(error){if(pending===request)pending=undefined;throw error;}return {content:[{type:"text",text:"Fresh-session handoff queued."}],details:{memoryPath:request.memoryPath},terminate:true};}});}
export default async function(pi:ExtensionAPI):Promise<void>{const pkg=JSON.parse(await readFile(join(getPackageDir(),"package.json"),"utf8"));registerHandoff(pi,{extensionFile:fileURLToPath(import.meta.url),packageVersion:pkg.version,lstat,readFile,getuid:process.getuid?.bind(process),path:nodePath,randomUUID,setInterval,clearInterval,setTimeout,clearTimeout});}
