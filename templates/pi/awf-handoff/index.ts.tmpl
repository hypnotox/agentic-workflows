// @ts-nocheck
/* c8 ignore start */
import { randomUUID } from "node:crypto";
import { execFile as execFileCallback } from "node:child_process";
import { promisify } from "node:util";
import { lstat, readFile } from "node:fs/promises";
import * as nodePath from "node:path";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { getPackageDir, type ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "typebox";

<!-- awf:include pi-minimum-runtime -->

const execFile=promisify(execFileCallback);
export interface HandoffStat { isSymbolicLink():boolean; isFile():boolean; isDirectory():boolean; }
export interface HandoffDependencies extends MinimumRuntimeDependencies { extensionFile:string; lstat(path:string):Promise<HandoffStat>; readFile(path:string,encoding:"utf8"):Promise<string>; path:any; randomUUID():string; setInterval(callback:()=>void,milliseconds:number):unknown; clearInterval(handle:unknown):void; setTimeout(callback:()=>void,milliseconds:number):unknown; clearTimeout(handle:unknown):void; }
function root(deps:HandoffDependencies):string{return deps.path.resolve(deps.path.dirname(deps.extensionFile),"../../..");}
function validID(value:any):boolean{return typeof value==="string"&&value.length>0&&Buffer.byteLength(value,"utf8")<=160&&!/[\\/\x00\r\n]/.test(value)&&value!=="."&&value!=="..";}
export async function validateMemoryPath(path:string,deps:HandoffDependencies):Promise<string>{if(!path||deps.path.isAbsolute(path)||!path.startsWith(".awf/memory/")||path.includes("\\")||path.split("/").some((x:string)=>!x||x==="."||x===".."))throw new Error("memoryPath must be a canonical file below .awf/memory/");let current=root(deps);for(const part of path.split("/")){current=deps.path.resolve(current,part);const stat=await deps.lstat(current);if(stat.isSymbolicLink()||(!stat.isDirectory()&&!stat.isFile()))throw new Error("memoryPath contains an unsafe filesystem entry");}return path;}
export async function validateMemoryEffort(path:string,deps:HandoffDependencies):Promise<string>{await validateMemoryPath(path,deps);const content=await deps.readFile(deps.path.resolve(root(deps),path),"utf8");const lines=content.split(/\r?\n/).filter((x:string)=>x.startsWith("Effort: "));if(lines.length!==1||!validID(lines[0]!.slice(8)))throw new Error("memory file must contain exactly one valid Effort: <id> line");return lines[0]!.slice(8);}
export function requestSelectedEffort(pi:ExtensionAPI):string|undefined{let answer:any;try{pi.events.emit("awf.effort.selection.request.v1",{respond:(value:any)=>{if(answer!==undefined)answer=null;else answer=value;}})}catch{return undefined};return answer&&validID(answer.effortId)?answer.effortId:undefined;}
function wrapper(memoryPath:string,kickoff:string):string{return `Read ${memoryPath} first. Repository sources and current-state documentation are authoritative over the checkpoint. The optional effort selection, if any, was assigned before this kickoff. Then continue with this immediate action: ${kickoff}`;}
async function runAwf(root:string,args:string[]):Promise<void>{await execFile("awf",args,{cwd:root,timeout:10_000,maxBuffer:1024*1024});}
export function registerHandoff(pi:ExtensionAPI,deps:HandoffDependencies):void{if(!guardMinimumRuntime(pi,deps,["on","registerTool","registerCommand","queueCommand"]))return;let pending:any;pi.registerCommand("awf-handoff-continue",{description:"Continue a validated fresh-session handoff.",async handler(token:string,ctx:any){const request=pending;if(!request||token!==request.id)throw new Error("No matching pending handoff request");try{const old=ctx.sessionManager.getSessionFile();if(!old)throw new Error("The active session is no longer persisted");await ctx.newSession({parentSession:old,async setup(manager:any){const child=manager.getSessionId?.();if(!validID(child))throw new Error("child session identity is unavailable");if(request.effortId)await runAwf(root(deps),["effort","assign",request.effortId,"--session",child]);},async withSession(next:any){try{await next.sendUserMessage(wrapper(request.memoryPath,request.kickoff));}catch{next.ui.setEditorText(wrapper(request.memoryPath,request.kickoff));next.ui.notify("Automatic kickoff failed; submit the prepared editor text.","warning");}}});}finally{if(pending?.id===request.id)pending=undefined;}}});pi.registerTool({name:"handoff_session",label:"Fresh Session Handoff",description:"Continue from an optional durable awf checkpoint in a parent-linked fresh Pi TUI session.",parameters:Type.Object({memoryPath:Type.Optional(Type.String()),kickoff:Type.String({maxLength:1000})},{additionalProperties:false}),async execute(_id:any,params:any,_signal:any,_update:any,ctx:any){if(!params.kickoff?.trim())throw new Error("kickoff must contain non-whitespace content");if(pending)throw new Error("A handoff request is already pending");const selected=requestSelectedEffort(pi);let memoryEffort:any;if(params.memoryPath)memoryEffort=await validateMemoryEffort(params.memoryPath,deps);if(selected&&memoryEffort&&selected!==memoryEffort)throw new Error("memory Effort does not match selected effort");// Memory is a validated handoff hint, not selection authority. Only an actual
// parent selection may assign or install selection in the child.
pending={id:deps.randomUUID(),memoryPath:params.memoryPath??"",kickoff:params.kickoff,effortId:selected};pi.queueCommand("awf-handoff-continue",pending.id);return {content:[{type:"text",text:"Fresh-session handoff queued."}],details:{memoryPath:pending.memoryPath},terminate:true};}});}
export default async function(pi:ExtensionAPI):Promise<void>{const pkg=JSON.parse(await readFile(join(getPackageDir(),"package.json"),"utf8"));registerHandoff(pi,{extensionFile:fileURLToPath(import.meta.url),packageVersion:pkg.version,lstat,readFile,path:nodePath,randomUUID,setInterval,clearInterval,setTimeout,clearTimeout});}

/* c8 ignore stop */
