// @ts-nocheck
import { randomUUID } from "node:crypto";
import { readFile } from "node:fs/promises";
import { getPackageDir, type ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { truncateToWidth } from "@earendil-works/pi-tui";
import { Type } from "typebox";

<!-- awf:include pi-minimum-runtime -->

export interface HandoffDependencies extends MinimumRuntimeDependencies { randomUUID():string; setInterval(callback:()=>void,milliseconds:number):unknown; clearInterval(handle:unknown):void; setTimeout(callback:()=>void,milliseconds:number):unknown; clearTimeout(handle:unknown):void; }
function countdown(ctx:any,deps:HandoffDependencies):Promise<boolean>{return ctx.ui.custom((tui:any,_theme:any,keybindings:any,done:any)=>{let seconds=5,interval:any,timeout:any,finished=false,cached:any;const finish=(result:boolean)=>{if(finished)return;finished=true;if(interval!==undefined)deps.clearInterval(interval);if(timeout!==undefined)deps.clearTimeout(timeout);done(result);};const component={render(width:number){const bounded=Math.max(1,width);if(!cached||cached.width!==bounded)cached={width:bounded,lines:[truncateToWidth(`Handoff to a fresh session in ${seconds}s - Esc/Ctrl+C to cancel`,bounded)]};return cached.lines;},invalidate(){cached=undefined;tui.requestRender();},handleInput(data:string){try{if(keybindings.matches(data,"tui.select.cancel"))finish(false);}catch(error){finish(false);throw error;}},dispose(){if(interval!==undefined)deps.clearInterval(interval);if(timeout!==undefined)deps.clearTimeout(timeout);}};try{interval=deps.setInterval(()=>{seconds=Math.max(1,seconds-1);component.invalidate();},1000);timeout=deps.setTimeout(()=>finish(true),5000);}catch(error){finish(false);throw error;}return component;});}
export function registerHandoff(pi:ExtensionAPI,deps:HandoffDependencies):void{if(!guardMinimumRuntime(pi,deps,["on","eventsEmit","registerTool","registerCommand","queueCommand"]))return;let pending:any;pi.on("tool_call",(event:any,ctx:any)=>{const leaf=ctx.sessionManager.getLeafEntry?.();const content=leaf?.type==="message"&&leaf.message?.role==="assistant"&&Array.isArray(leaf.message.content)?leaf.message.content:[];const calls=content.filter((item:any)=>item?.type==="toolCall");const correlated=calls.some((call:any)=>call.id===event.toolCallId&&call.name===event.toolName);if(!correlated)return event.toolName==="handoff_session"?{block:true,reason:"Cannot verify the current tool batch; retry handoff_session alone."}:undefined;if(calls.length>1&&calls.some((call:any)=>call.name==="handoff_session"))return {block:true,reason:"A batch containing handoff_session cannot contain siblings; retry handoff_session alone."};});pi.registerCommand("awf-handoff-continue",{description:"Continue a fresh-session handoff.",async handler(token:string,ctx:any){const request=pending;if(!request||token!==request.id)throw new Error("No matching pending handoff request");const kickoff=request.kickoff;let prepared:any;try{if(!await countdown(ctx,deps)){ctx.ui.notify("Fresh-session handoff canceled.");return;}if(pending!==request)throw new Error("No matching pending handoff request");const old=ctx.sessionManager.getSessionFile();if(!old)throw new Error("The active session is no longer persisted");await ctx.newSession({parentSession:old,async setup(manager:any){prepared=manager;},async withSession(next:any){prepared=undefined;try{await next.sendUserMessage(kickoff);}catch{next.ui.setEditorText(kickoff);next.ui.notify("Automatic kickoff failed; submit the prepared editor text.","warning");}}});}catch(error){try{await prepared?.cleanup?.();ctx.ui.setEditorText(kickoff);ctx.ui.notify("Fresh-session handoff failed; recovery text is in the editor.","error");}catch{}throw error;}finally{if(pending?.id===request.id)pending=undefined;}}});pi.registerTool({name:"handoff_session",label:"Fresh Session Handoff",description:"Continue in a parent-linked fresh Pi TUI session.",parameters:Type.Object({kickoff:Type.String({maxLength:1000})},{additionalProperties:false}),async execute(_id:any,params:any,_signal:any,_update:any,ctx:any){if(ctx.mode!=="tui"||!ctx.sessionManager.getSessionFile?.())throw new Error("handoff_session requires a persisted interactive Pi TUI session");if(typeof params.kickoff!=="string"||params.kickoff.trim().length===0)throw new Error("kickoff must contain non-whitespace content");if(params.kickoff.length>1000)throw new Error("kickoff must not exceed 1000 UTF-16 code units");if(pending)throw new Error("A handoff request is already pending");const request={id:deps.randomUUID(),kickoff:params.kickoff};pending=request;try{pi.queueCommand("awf-handoff-continue",request.id);}catch(error){if(pending===request)pending=undefined;throw error;}return {content:[{type:"text",text:"Fresh-session handoff queued."}],details:{kickoff:request.kickoff},terminate:true};}});}
export default async function(pi:ExtensionAPI):Promise<void>{const pkg=JSON.parse(await readFile(`${getPackageDir()}/package.json`,"utf8"));registerHandoff(pi,{packageVersion:pkg.version,randomUUID,setInterval,clearInterval,setTimeout,clearTimeout});}
