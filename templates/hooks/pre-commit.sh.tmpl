#!/usr/bin/env bash
# Pre-commit payload: the configured aggregate check, then the project gate. Inert until wired into a hook setup you own, e.g. a
# .git/hooks/pre-commit stub containing:
#   exec bash .awf/hooks/pre-commit.sh "$@"
set -euo pipefail
{{- with .vars.checkCmd }}
{{ . }}
{{- else }}
./awf check
{{- end }}
{{- with .vars.gateCmd }}
{{ . }}
{{- end }}
