#!/usr/bin/env bash
# Commit-msg payload: the deterministic Conventional Commits and definitive
# stale-ADR merge authorization gate. Inert until wired
# into a hook setup you own, e.g. a .git/hooks/commit-msg stub containing:
#   exec bash .awf/hooks/commit-msg.sh "$@"
set -euo pipefail
{{ with .vars.commitGateCmd }}{{ . }}{{ else }}./awf check staged commit{{ end }} "$1"
