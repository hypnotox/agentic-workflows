#!/usr/bin/env bash
# Command runner for the sundial repo - project verbs only; awf verbs go through ./awf.
set -euo pipefail

cmd="${1:-}"
shift || true

case "$cmd" in
  gate)
    if [ "$#" -ne 0 ]; then
      echo "usage: ./x gate" >&2
      exit 2
    fi
    go test ./...
    go vet ./... ;;
  test)
    go test ./... "$@" ;;
  *)
    echo "usage: ./x {gate|test}" >&2
    exit 1 ;;
esac
